# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Which LLM provider the orchestration layer uses: "groq", "xai", or "openai".
LLM_PROVIDER=groq

# --- Groq ---
# Get a free key at https://console.groq.com (keys start with "gsk_").
# Note: Groq's model lineup changes over time — check console.groq.com/docs/models
# if GROQ_MODEL below ever returns a "model decommissioned" error.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# --- xAI (Grok) --- (different from Groq! keys start with "xai-")
XAI_API_KEY=your-xai-api-key-here
XAI_MODEL=grok-4-fast

# --- OpenAI (only needed if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Chroma persistence directory
CHROMA_DB_DIR=./rag/chroma_db
